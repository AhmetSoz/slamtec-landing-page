     "box": {
      "x": 12.1,
      "y": -0.7,
      "w": 75.8,
      "h": 4.3
     }
    },
    {
     "tag": "P",
     "cls": "auroras-txt aos-init",
     "t": "Aurora S integrates AI-VSLAM for full-scene 3D mapping and localization, stereo depth estimation, semantic recognition, and dedicated compute hardware. It delivers real-time, high-quality spatial perception outputs—mapping, localization, and more—directly to the user, without the need for additional compute resources or in-house algorithm development.",
     "fs": 18,
     "fw": "400",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 12.1,
      "y": 28.3,
      "w": 75.8,
      "h": 6.7
     }
    }
   ],

   "texts": [
    {
     "tag": "H3",
     "cls": "",
     "t": "OPTMAG Original Design, 5 Years Ultra-long Life",
     "fs": 36,
     "fw": "700",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 0,
      "y": 10.6,
      "w": 100,
      "h": 5.6
     }
    },
    {
     "tag": "P",
     "cls": "",
     "t": "Most traditional non-solid LIDARs use slip ring to transfer power and data information, however, they only have thousands of\nhours of life due to mechanical wearing out. SLAMTEC has integrated the wireless power and optical communication technology\nto self-design the OPTMAG technology, which breakouts the life limitation of traditional LIDAR system.It fixes the electrical\nconnection failure caused by the physical wearing out so as to prolong the life to 5 years and even more.",
     "fs": 18,
     "fw": "400",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 0,
      "y": 16.1,
      "w": 100,
      "h": 12.1
     }
    }

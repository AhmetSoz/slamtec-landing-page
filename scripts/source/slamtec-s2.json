   "texts": [
    {
     "tag": "DIV",
     "cls": "s2-section2",
     "t": "START Signal\nSTOP Signal\nDTOF Ranging Method\nThanks to the DTOF (Direct Time-of-Flight) technology developed by SLAMTEC, RPLIDAR S2 guarantees consistent ranging resolution. Even in longer distance, the resolution always keeps the same. Also, DTOF allows RPLIDAR S2 to detect almost ANY thing with different material types, no matter a darker object, a high reflective mirror, or even transparent glass.",
     "fs": 14,
     "fw": "400",
     "c": "rgb(51, 51, 51)",
     "box": {
      "x": 0,
      "y": 0,
      "w": 100,
      "h": 100
     }
    },
    {
     "tag": "H2",
     "cls": "s2-tit",
     "t": "DTOF Ranging Method",
     "fs": 32,
     "fw": "500",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 0,
      "y": 13.3,
      "w": 100,
      "h": 3.9
     }
    },
    {
     "tag": "P",
     "cls": "s2-txt",
     "t": "Thanks to the DTOF (Direct Time-of-Flight) technology developed by SLAMTEC, RPLIDAR S2 guarantees consistent ranging resolution. Even in longer distance, the resolution always keeps the same. Also, DTOF allows RPLIDAR S2 to detect almost ANY thing with different material types, no matter a darker object, a high reflective mirror, or even transparent glass.",
     "fs": 18,
     "fw": "400",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 21.4,
      "y": 21.1,

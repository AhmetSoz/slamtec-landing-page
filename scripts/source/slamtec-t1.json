  {
   "si": 1,
   "cls": "t1-section",
   "h": 891,
   "w": 1901,
   "texts": [
    {
     "tag": "P",
     "cls": "t1-txt-left",
     "t": "LPX-T1 is the first-generation high-performance laser LiDAR developed by SLAMTEC. With a range of 40 meters and a sampling frequency of up to 60,000 times per second, it offers excellent resistance to environmental light up to 80,000 lux. With a scanning angle of 270 degrees, it generates real-time point cloud maps, providing precise environmental perception and navigation capabilities. Specifically designed for AGV scenarios, it is suitable for applications in service robots, lightweight autonomous driving, and more. LPX-T1 is the ideal choice for solving robot localization and map-building.",
     "fs": 18,
     "fw": "400",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 4.2,
      "y": 36.8,
      "w": 30.2,
      "h": 26.4
     }
    }
   ],
   "imgs": [
    {
     "src": "https://image.slamtec.com/images/t1/pc/t1-section0-cn.webp",
     "alt": "LPX-T1 introduction background",
     "nw": 1920,
     "nh": 900,
     "box": {
      "x": 0,
      "y": 0,
      "w": 100,
      "h": 100
     },
     "pcls": "fullpage-img"
    }
   ],
   "vids": [],
   "bgs": []
  },
  {
   "si": 2,
   "cls": "t1-section",
   "h": 887,
   "w": 1901,
   "texts": [
    {
     "tag": "H2",
     "cls": "t1-tit",
     "t": "40 meters medium and long distance detection capability",
     "fs": 32,
     "fw": "500",
     "c": "rgb(84, 62, 154)",
     "box": {
      "x": 0,
      "y": 13.3,
      "w": 100,
      "h": 4
     }
    },
    {
     "tag": "P",
     "cls": "t1-txt",
     "t": "The LPX-T1 is capable of reliable detection within a range of 40 meters, enabling identification and tracking of long-distance targets. It provides robots with a wider sensing range and longer reaction time, enhancing the safety and adaptability of the system. It is suitable for various scenarios such as warehouses, factories, distribution stations, hotels, restaurants, shopping malls, and office buildings.",
     "fs": 18,
     "fw": "400",
     "c": "rgb(3, 3, 5)",
     "box": {
      "x": 21.4,
      "y": 21.1,
      "w": 59.9,
      "h": 8.8
     }
    }
   ],
   "imgs": [
    {

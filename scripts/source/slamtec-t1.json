  {
   "si": 4,
   "cls": "t1-section",
   "h": 891,
   "w": 1901,
   "texts": [
    {
     "tag": "H2",
     "cls": "t1-tit",
     "t": "Super fine object detection ability",
     "fs": 32,
     "fw": "500",
     "c": "rgb(84, 62, 154)",
     "box": {
      "x": 0,
      "y": 13.3,
      "w": 100,
      "h": 3.9
     }
    },
    {
     "tag": "P",
     "cls": "t1-txt",
     "t": "Small object detection is one of the crucial functions in AGV scenarios. LPX-T1 has an angular resolution of up to 0.12°, which can accurately capture and identify subtle object details, ensuring accurate detection of small-sized targets. Whether it is an obstacle in a warehouse, an obstacle in a narrow passage, or a small object in a complex environment, the LPX-T1 can achieve efficient detection and identification with excellent accuracy, providing AGV with reliable navigation and obstacle avoidance capabilities.",
     "fs": 18,
     "fw": "400",
     "c": "rgb(3, 3, 5)",
     "box": {
      "x": 21.4,
      "y": 21.1,
      "w": 59.9,
      "h": 11.7
     }
    }
   ],
   "imgs": [
    {

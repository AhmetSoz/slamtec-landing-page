  {
   "si": 3,
   "cls": "t1-section",
   "h": 808,
   "w": 1901,
   "texts": [
    {
     "tag": "H2",
     "cls": "t1-tit",
     "t": "60,000 times/second high-speed sampling capabilities",
     "fs": 32,
     "fw": "500",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 0,
      "y": 13.3,
      "w": 100,
      "h": 4.4
     }
    },
    {
     "tag": "P",
     "cls": "t1-txt",
     "t": "LPX-T1 has improved the internal optical design and algorithm system, and has a laser ranging sampling capability of up to 60,000 times per second to meet the needs of high-speed movement. It can update environmental data in real time, provide support for rapid decision-making and adjustment, and keep the robot stable and accurate in the case of fast movement.",
     "fs": 18,
     "fw": "400",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 21.4,
      "y": 21.1,
      "w": 59.9,
      "h": 9.7
     }
    }
   ],
   "imgs": [
    {
     "src": "https://image.slamtec.com/images/t1/pc/t1-section2-cn.gif",

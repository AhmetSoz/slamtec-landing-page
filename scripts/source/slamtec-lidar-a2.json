   "texts": [
    {
     "tag": "H2",
     "cls": "a2-tit",
     "t": "OPTMAG Original Design",
     "fs": 24,
     "fw": "700",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 0,
      "y": 7.8,
      "w": 100,
      "h": 3
     }
    },
    {
     "tag": "P",
     "cls": "a2-txt",
     "t": "Most traditional non-solid LIDARs use slip ring to transfer power and data information, however, they only\nhave thousands of hours of life due to mechanical wearing out. Slamtec has integrated the wireless power\nand optical communication technology to self-design the OPTMAG technology, which breakouts the life limitation\nof traditional LIDAR system. It fixes the electrical connection failure caused by the\nphysical wearing out so as to prolong the life-span.",
     "fs": 18,
     "fw": "400",
     "c": "rgb(255, 255, 255)",
     "box": {
      "x": 10.9,
      "y": 15.6,
      "w": 78.1,
      "h": 14.6
     }
    },

    {
     "tag": "P",
     "cls": "mapper-txt",
     "t": "Slamtec Mapper, a new laser range scanner category integrating map building and real time\nlocalization and navigation, contains the SLAMTEC third generation high-performance SLAM engine and laser\nrange scanner. Plug and play, without any external dependence. It is suitable to be applied\nin application fields like robot localization and navigation, environment surveying and mapping and etc.",
     "fs": 18,
     "fw": "400",
     "c": "rgb(82, 79, 78)",
     "box": {
      "x": 1.1,
      "y": 7.8,
      "w": 97.9,
      "h": 11.7
     }
    }
   ],
   "imgs": [
    {
